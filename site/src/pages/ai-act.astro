---
import Basis from "../layouts/Basis.astro";
import { SITE_URL, auteur, uitgever, LICENTIE_URL } from "../lib/seo";

// Tijdlijn na de AI Omnibus (aangenomen door Parlement en Raad in juni 2026, gepubliceerd 24 juli 2026).
// Laatst nagekeken: zie NAGEKEKEN. Bij elke wijziging: datum aanpassen en bronnen controleren.
const NAGEKEKEN = "27 oktober 2026";
const tijdlijn = [
  { datum: "1 augustus 2024", wat: "De AI Act treedt in werking. De regels gaan stap voor stap gelden.", status: "voorbij" },
  { datum: "2 februari 2025", wat: "Verboden AI-praktijken gelden, zoals sociale scoring en emotieherkenning op het werk en op school. Ook de plicht rond AI-geletterdheid start.", status: "voorbij" },
  { datum: "2 augustus 2025", wat: "Regels voor AI-modellen voor algemeen gebruik (zoals de modellen achter ChatGPT, Claude en Gemini) gelden. Ook de sancties en het toezichtskader.", status: "voorbij" },
  { datum: "2 augustus 2026", wat: "De AI Act geldt algemeen, waaronder de transparantieregels: je moet weten dat je met een chatbot praat, en deepfakes moeten herkenbaar zijn.", status: "voorbij" },
  { datum: "2 december 2026", wat: "Nieuw verbod op AI die seksueel misbruikmateriaal van kinderen of niet-consensueel intiem beeldmateriaal maakt (zoals 'nudify'-apps). Ook een overgangsregel voor het labelen van AI-inhoud geldt dan.", status: "komt" },
  { datum: "2 augustus 2027", wat: "AI-modellen voor algemeen gebruik die al vóór augustus 2025 op de markt waren, moeten voldoen. Elke lidstaat moet minstens één testomgeving (regulatory sandbox) hebben.", status: "komt" },
  { datum: "2 december 2027", wat: "De regels voor AI met een hoog risico gelden, bijvoorbeeld in onderwijs, werk en openbare dienstverlening (bijlage III). Oorspronkelijk was dit augustus 2026.", status: "komt" },
  { datum: "2 augustus 2028", wat: "De regels gelden ook voor AI in producten die al onder Europese productregels vallen, zoals medische toestellen en machines (bijlage I).", status: "komt" },
];

const doelgroepen = [
  {
    naam: "Scholen",
    id: "scholen",
    punten: [
      "Emotieherkenning bij leerlingen is verboden, sinds februari 2025.",
      "AI die beslist over toelating, leerresultaten beoordeelt of spieken tijdens examens opspoort, geldt als hoog risico. Vanaf 2 december 2027 gelden daarvoor extra plichten, ook voor de school die het systeem gebruikt: menselijk toezicht, logboeken bijhouden, betrokkenen informeren.",
      "Gebruikt de school AI, dan moet ze de ontwikkeling van AI-geletterdheid bij haar personeel ondersteunen.",
    ],
  },
  {
    naam: "Gemeenten en andere overheden",
    id: "overheden",
    punten: [
      "Sociale scoring van burgers is verboden.",
      "AI die beslist over toegang tot uitkeringen, sociale steun of andere essentiële diensten geldt als hoog risico. Overheden die zo'n systeem inzetten, moeten vanaf 2 december 2027 eerst de gevolgen voor de grondrechten beoordelen en het systeem registreren in de Europese databank.",
      "Een chatbot op de gemeentelijke website moet duidelijk maken dat het een chatbot is, sinds augustus 2026.",
    ],
  },
  {
    naam: "Kmo's, zelfstandigen en werkgevers",
    id: "bedrijven",
    punten: [
      "De meeste bedrijven zijn gebruiker van AI, geen maker. Voor gewone toepassingen (teksten schrijven, samenvatten, vertalen) gelden vooral de regels rond AI-geletterdheid en transparantie.",
      "AI om sollicitanten te selecteren, cv's te sorteren of werknemers te beoordelen geldt als hoog risico, met extra plichten vanaf 2 december 2027.",
      "Emotieherkenning bij werknemers is verboden.",
      "Gebruik je een chatbot voor klanten of maak je deepfakes, dan moet dat herkenbaar zijn.",
    ],
  },
  {
    naam: "Burgers",
    id: "burgers",
    punten: [
      "Je hebt het recht te weten dat je met een chatbot praat, en AI-beelden of -video's die echt lijken moeten herkenbaar zijn.",
      "Sommige toepassingen zijn verboden: manipulatie die schade toebrengt, sociale scoring, emotieherkenning op werk en school, en (vanaf december 2026) apps die naaktbeelden van echte mensen maken.",
      "Klagen kan voorlopig vooral via de rechtbank of de AI Act Service Desk van de Europese Commissie. Een Belgische toezichthouder is nog niet officieel aangeduid.",
    ],
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "AI Act-kompas voor Vlaanderen",
  description: "Wat de Europese AI-verordening betekent voor scholen, gemeenten, kmo's en burgers in Vlaanderen, met de tijdlijn na de AI Omnibus.",
  dateModified: "2026-10-27",
  inLanguage: "nl-BE",
  url: `${SITE_URL}/ai-act`,
  author: { "@id": auteur["@id"], "@type": "Person", name: auteur.name },
  publisher: { "@id": uitgever["@id"], "@type": "NewsMediaOrganization", name: uitgever.name },
  license: LICENTIE_URL,
  about: { "@type": "Legislation", name: "Verordening (EU) 2024/1689 (AI-verordening)", legislationIdentifier: "2024/1689" },
};
---

<Basis titel="AI Act-kompas voor Vlaanderen: wat geldt wanneer?" beschrijving="Wat betekent de Europese AI Act voor scholen, gemeenten, kmo's en burgers in Vlaanderen? Tijdlijn na de AI Omnibus, in gewoon Nederlands." schema={schema}>
  <section class="rij sectie">
    <div class="kantlijn"><p>Laatst nagekeken: {NAGEKEKEN}</p></div>
    <div class="proza">
      <h1 style="margin-top:0">AI Act-kompas voor Vlaanderen</h1>
      <p class="lead">
        <span class="markeer">De AI Act is de Europese wet die regels oplegt aan AI, strenger naarmate het risico groter is.</span>{" "}
        Deze pagina zegt in gewoon Nederlands wat er wanneer geldt, en wat het betekent voor jou.
      </p>
      <p>
        In juli 2026 werd de wet aangepast met de zogenoemde AI Omnibus. Daardoor schuiven de strengste regels, die voor AI met een hoog risico, op naar december 2027 en augustus 2028.
        De plicht rond AI-geletterdheid werd afgezwakt: organisaties moeten de ontwikkeling ervan bij hun mensen ondersteunen, maar hoeven geen bepaald niveau te garanderen.
      </p>
    </div>
  </section>

  <section class="rij sectie">
    <div class="kantlijn"><p>Wat geldt wanneer</p></div>
    <div>
      <h2 style="margin-top:0">Tijdlijn</h2>
      <ol class="tijdlijn">
        {tijdlijn.map((t) => (
          <li data-status={t.status}>
            <p class="tijdlijn-datum">{t.datum}{t.status === "voorbij" ? "" : " (komt eraan)"}</p>
            <p>{t.wat}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {doelgroepen.map((d) => (
    <section class="rij sectie" id={d.id}>
      <div class="kantlijn"><p>Wat betekent het voor</p></div>
      <div class="proza">
        <h2>{d.naam}</h2>
        <ul>{d.punten.map((p) => <li>{p}</li>)}</ul>
      </div>
    </section>
  ))}

  <section class="rij sectie">
    <div class="kantlijn"><p>België</p></div>
    <div class="proza">
      <h2>Wie houdt toezicht in België?</h2>
      <p>
        Elke lidstaat moest tegen augustus 2025 een toezichthouder aanduiden. België deed dat niet op tijd. Het BIPT, de regulator voor telecom en post, ligt het meest voor de hand,
        maar daarvoor is nog een wet nodig. Voor onderwijs en werk zijn ook de gewesten bevoegd, en een akkoord tussen federale en regionale overheden ontbreekt nog
        (<a href="https://www.vrt.be/vrtnws/nl/2026/07/29/geen-toezichthouder-wel-al-strengere-regels-hoe-ver-staat-belg/">VRT NWS, juli 2026</a>).
        Voor de grote AI-modellen houdt het AI-bureau van de Europese Commissie zelf toezicht.
      </p>
    </div>
  </section>

  <section class="rij sectie klein">
    <div class="kantlijn"><p>Bronnen</p></div>
    <div class="proza">
      <ul>
        <li><a href="https://eur-lex.europa.eu/eli/reg/2024/1689/oj">Verordening (EU) 2024/1689 (AI Act)</a>, EUR-Lex</li>
        <li><a href="https://fpf.org/blog/the-ai-act-implementation-timeline-what-changes-under-the-ai-omnibus/">The AI Act implementation timeline: what changes under the AI Omnibus?</a>, Future of Privacy Forum</li>
        <li><a href="https://www.vrt.be/vrtnws/nl/2026/07/29/geen-toezichthouder-wel-al-strengere-regels-hoe-ver-staat-belg/">Geen toezichthouder, wel al strengere regels</a>, VRT NWS</li>
      </ul>
      <p>Dit is geen juridisch advies. Bij twijfel over je eigen situatie: raadpleeg een jurist. Zie je een fout of een wijziging? <a href="/correcties">Meld het</a>.</p>
    </div>
  </section>
</Basis>
