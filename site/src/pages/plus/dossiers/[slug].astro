---
import Basis from "../../../layouts/Basis.astro";
import Inhoud from "../../../components/Inhoud.astro";
import HypeMeter from "../../../components/HypeMeter.astro";
import Inschrijven from "../../../components/Inschrijven.astro";
import { alleDossiers, type Dossier } from "../../../lib/plus";
import { datumLeesbaar } from "../../../lib/edities";
import { LICENTIE_URL, SITE_URL, auteur, uitgever } from "../../../lib/seo";

export function getStaticPaths() {
  return alleDossiers().map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props as { d: Dossier };
const url = `${SITE_URL}/plus/dossiers/${d.slug}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "AnalysisNewsArticle",
  "@id": url,
  mainEntityOfPage: url,
  headline: d.titel,
  description: d.samenvatting,
  datePublished: d.datum,
  inLanguage: "nl-BE",
  image: [`${SITE_URL}/og.png`],
  author: { "@id": auteur["@id"], "@type": "Person", name: auteur.name, url: auteur.url },
  publisher: { "@id": uitgever["@id"], "@type": "NewsMediaOrganization", name: uitgever.name, logo: uitgever.logo },
  license: LICENTIE_URL,
  isAccessibleForFree: true,
};
---

<Basis titel={d.titel} beschrijving={d.samenvatting.slice(0, 160)} type="article" schema={schema} gepubliceerd={d.datum}>
  <article>
    <header class="rij sectie">
      <div class="kantlijn">
        <p class="kantlijn-kop">Dossier</p>
        <p>{datumLeesbaar(d.datum)} · <a href="/plus">Plus</a></p>
        <p class="pagina-uitleg">Eén ontwikkeling grondig uitgelegd: wat er gebeurde, wat het betekent en wat je nu doet.</p>
        {d.labels.length > 0 && <ul class="labels" aria-label="Voor wie">{d.labels.map((l) => <li>{l}</li>)}</ul>}
        {d.hype && <HypeMeter hype={d.hype} />}
      </div>
      <div>
        <h1 style="font-size:2.2rem;margin:0 0 1.25rem">{d.titel}</h1>
        <div class="lead proza" set:html={d.kort} />
        <Inhoud titel="In dit dossier" items={[...d.secties.map((x) => ({ href: `#${x.slug}`, tekst: x.titel })), { href: "#inschatting", tekst: "Mijn inschatting" }]} />
      </div>
    </header>

    {d.secties.map((s) => (
      <section class="rij sectie" id={s.slug}>
        <div class="kantlijn"></div>
        <div class="proza"><h2>{s.titel}</h2><Fragment set:html={s.html} /></div>
      </section>
    ))}

    <section class="rij sectie" id="inschatting">
      <div class="kantlijn"><p>Ondertekend oordeel van de eindredacteur</p></div>
      <div class="inschatting proza">
        <h2>Mijn inschatting</h2>
        <Fragment set:html={d.inschatting} />
        <p class="handtekening">Duncan Panis</p>
      </div>
    </section>

    <section class="rij sectie klein">
      <div class="kantlijn"><p>Transparantie</p></div>
      <div class="proza"><h2>Zo is dit gemaakt</h2><Fragment set:html={d.gemaakt} /></div>
    </section>

    <section class="rij sectie klein">
      <div class="kantlijn"><p>Fout gezien? <a href="/correcties">Meld het</a></p></div>
      <div class="proza"><h2>Bronnen</h2><Fragment set:html={d.bronnen} /></div>
    </section>
  </article>

  <section class="rij sectie">
    <div class="kantlijn"></div>
    <div><Inschrijven /></div>
  </section>
</Basis>
