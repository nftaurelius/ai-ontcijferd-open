---
import Basis from "../../layouts/Basis.astro";
import Inschrijven from "../../components/Inschrijven.astro";
import { allePakketten, SOORTEN, grootte, totaleGrootte } from "../../lib/materiaal";
import { datumLeesbaar } from "../../lib/edities";
import { LICENTIE_URL, SITE_URL, uitgever } from "../../lib/seo";

const pakketten = allePakketten();
const beschikbaar = pakketten.filter((p) => p.status === "beschikbaar");
const komend = pakketten.filter((p) => p.status !== "beschikbaar");
const soorten = [...new Set(beschikbaar.map((p) => p.soort))];
const doelgroepen = [...new Set(beschikbaar.flatMap((p) => p.voor))];
const url = `${SITE_URL}/materiaal`;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": url,
  url,
  name: "Open lesmateriaal over AI",
  description: "Gratis lespakketten, lezingen en een AI-cursus onder Creative Commons, om aan te passen aan je eigen organisatie.",
  inLanguage: "nl-BE",
  isAccessibleForFree: true,
  license: LICENTIE_URL,
  publisher: { "@id": uitgever["@id"], "@type": "NewsMediaOrganization", name: uitgever.name },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: beschikbaar.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: `${url}/${p.slug}`, name: p.titel })),
  },
};
---

<Basis titel="Open lesmateriaal over AI" beschrijving="Gratis lespakketten, lezingen en een AI-cursus van AI Ontcijferd. Download, pas aan met AI voor je eigen organisatie, en geef het zelf. Vrij te gebruiken onder Creative Commons." schema={schema}>
  <section class="rij sectie">
    <div class="kantlijn"><p>Gratis en open<br />Onder Creative Commons</p></div>
    <div class="proza">
      <h1 style="margin-top:0">Open lesmateriaal</h1>
      <p class="lead">
        <span class="markeer">Workshops, lezingen en een AI-cursus, klaar om zelf te geven.</span>{" "}
        Voor bibliotheken, scholen, gemeenten, bedrijven en verenigingen.
      </p>
      <p>
        Elk pakket bevat wat je nodig hebt om een sessie te geven: een draaiboek met wat je doet en zegt, de presentatie, werkbladen,
        en wat je doet als iets misloopt. Je mag alles aanpassen. Met de prompt die we meegeven, maakt je eigen AI-assistent er in een paar minuten
        een versie van voor jouw publiek.
      </p>
    </div>
  </section>

  <section class="rij sectie">
    <div class="kantlijn"><p class="kantlijn-kop">In drie stappen</p></div>
    <div>
      <ol class="stappen">
        <li><strong>Kies een pakket</strong> en download alles in één zip, of de bestanden apart.</li>
        <li><strong>Maak het van jou.</strong> Geef de bestanden en onze prompt aan een AI-assistent, met wat informatie over je organisatie en je publiek.</li>
        <li><strong>Kijk het na en geef het.</strong> Laat de naamsvermelding staan. Meer hoeft niet.</li>
      </ol>
      <p><a href="/materiaal/gebruiken">Lees de uitleg in stappen</a>, met de prompt, de licentie en wat je beter niet doet.</p>
    </div>
  </section>

  {beschikbaar.length > 0 ? (
    <>
      {(soorten.length > 1 || doelgroepen.length > 1) && (
        <section class="rij sectie filter-sectie">
          <div class="kantlijn"><p>Toon</p></div>
          <div>
            {doelgroepen.length > 1 && (
              <div class="filter" role="group" aria-label="Filter op doelgroep">
                <button type="button" data-voor="" aria-pressed="true">Iedereen</button>
                {doelgroepen.map((d) => <button type="button" data-voor={d} aria-pressed="false">{d}</button>)}
              </div>
            )}
            {soorten.length > 1 && (
              <div class="filter" role="group" aria-label="Filter op soort">
                <button type="button" data-soort="" aria-pressed="true">Alles</button>
                {soorten.map((s) => <button type="button" data-soort={s} aria-pressed="false">{SOORTEN[s]}</button>)}
              </div>
            )}
          </div>
        </section>
      )}
      <section class="rij sectie" aria-label="Beschikbare pakketten">
        <div class="kantlijn"><p>{beschikbaar.length} {beschikbaar.length === 1 ? "pakket" : "pakketten"}</p></div>
        <ul class="aanbod">
          {beschikbaar.map((p) => (
            <li data-pakket data-soort={p.soort} data-voor={p.voor.join("|")}>
              <p class="aanbod-soort"><span class="soort">{SOORTEN[p.soort]}</span> Versie {p.versie}{p.bijgewerkt && `, bijgewerkt ${datumLeesbaar(p.bijgewerkt)}`}</p>
              <h2><a href={`/materiaal/${p.slug}`}>{p.titel}</a></h2>
              <p>{p.samenvatting}</p>
              <p class="meta">
                {[p.deelnemers && `Voor ${p.deelnemers.charAt(0).toLowerCase()}${p.deelnemers.slice(1)}`, p.duur, p.niveau, p.voor.length && `Om te geven in: ${p.voor.join(", ").toLowerCase()}`]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
              <p>
                <a class="knop" href={p.zipUrl} download={p.zipNaam}>Download (.zip, {grootte(totaleGrootte(p))})</a>{" "}
                <a href={`/materiaal/${p.slug}`} style="margin-left:0.75rem">Wat zit erin?</a>
              </p>
            </li>
          ))}
        </ul>
        <p class="meta" id="filter-leeg" hidden>Nog geen pakketten met deze filter.</p>
      </section>
    </>
  ) : (
    <section class="rij sectie">
      <div class="kantlijn"><p class="kantlijn-kop">Beschikbaar</p></div>
      <div class="proza">
        <p class="lead">Het eerste pakket verschijnt binnenkort.</p>
        <p>Schrijf je in op de nieuwsbrief, dan weet je het als het er is.</p>
      </div>
    </section>
  )}

  {komend.length > 0 && (
    <section class="rij sectie" aria-labelledby="h-komend">
      <div class="kantlijn"><p class="kantlijn-kop" id="h-komend">In voorbereiding</p></div>
      <div>
        <ul class="komend">
          {komend.map((p) => (
            <li>
              <span class="soort">{SOORTEN[p.soort]}</span>
              <strong>{p.titel}</strong>
              {p.samenvatting && <p>{p.samenvatting}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="rij sectie">
    <div class="kantlijn"><p class="kantlijn-kop">Nieuw materiaal</p></div>
    <div><Inschrijven variant="kort" /></div>
  </section>

  <section class="rij sectie klein">
    <div class="kantlijn"><p>Iets gemaakt?</p></div>
    <div class="proza">
      <p>
        Gaf je een sessie met een van deze pakketten, of maakte je een versie die anderen kan helpen? Mail het naar{" "}
        <a href="mailto:redactie@aiontcijferd.be">redactie@aiontcijferd.be</a>. Fouten melden mag ook: we verbeteren het pakket en verhogen het versienummer.
      </p>
    </div>
  </section>
</Basis>

<script>
  const kaarten = Array.from(document.querySelectorAll<HTMLElement>("[data-pakket]"));
  const leeg = document.getElementById("filter-leeg");
  const staat = { voor: "", soort: "" };
  function pasToe() {
    let zichtbaar = 0;
    for (const k of kaarten) {
      const ok = (!staat.voor || (k.dataset.voor ?? "").split("|").includes(staat.voor)) && (!staat.soort || k.dataset.soort === staat.soort);
      k.hidden = !ok;
      if (ok) zichtbaar++;
    }
    if (leeg) leeg.hidden = zichtbaar > 0;
    document.querySelectorAll<HTMLButtonElement>("[data-voor]").forEach((b) => b.tagName === "BUTTON" && b.setAttribute("aria-pressed", String(b.dataset.voor === staat.voor)));
    document.querySelectorAll<HTMLButtonElement>("button[data-soort]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.soort === staat.soort)));
  }
  document.querySelectorAll<HTMLButtonElement>("button[data-voor]").forEach((b) => b.addEventListener("click", () => { staat.voor = b.dataset.voor ?? ""; pasToe(); }));
  document.querySelectorAll<HTMLButtonElement>("button[data-soort]").forEach((b) => b.addEventListener("click", () => { staat.soort = b.dataset.soort ?? ""; pasToe(); }));
</script>
