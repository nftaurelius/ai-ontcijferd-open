---
import Basis from "../../layouts/Basis.astro";
import { beschikbarePakketten, type Pakket } from "../../lib/materiaal";
import { VRAGEN, mailto } from "./_vragen";

export function getStaticPaths() {
  return beschikbarePakketten().map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Pakket };
const naam = p.titel.replace(/\?$/, ""); // "Echt of nep?" zonder dubbel vraagteken
---

<Basis titel={`Gaf je ${naam}? Laat het weten`} beschrijving={`Gaf je ${naam} van AI Ontcijferd? Vertel in een korte mail wat werkte en wat niet.`}>
  <section class="rij sectie">
    <div class="kantlijn"><p>Open lesmateriaal</p></div>
    <div class="proza">
      <h1 style="margin-top:0">Gaf je {naam}?</h1>
      <p class="lead"><span class="markeer">Laat het weten. Twee minuten van jou maken de volgende versie beter.</span></p>
      <p>Je gaf versie {p.versie}. Het pakket is nog niet in de praktijk getest, dus jouw ervaring is de eerste die we horen.</p>
      <h2>Wat we graag horen</h2>
      <ol>{VRAGEN.map(([v, u]) => <li><strong>{v}</strong> {u}</li>)}</ol>
      <p><a class="knop" href={mailto(p.titel, p.versie)}>Mail het naar de redactie</a></p>
      <p>Lukt de knop niet? Mail naar <strong>redactie@aiontcijferd.be</strong> met als onderwerp "Ik gaf {p.titel}".</p>
      <p class="meta">Noem geen namen van deelnemers. Je mail komt bij de eindredacteur terecht; zie <a href="/privacy">privacy</a>. Terug naar <a href={`/materiaal/${p.slug}`}>het pakket</a>.</p>
    </div>
  </section>
</Basis>
